<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry including="**/*.java" kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry excluding="**" kind="src" output="target/classes" path="resources">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="optional" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="lib/sqlite-jdbc-3.50.3.0.jar"/>
	<classpathentry kind="lib" path="lib/commons-io-2.20.0.jar"/>
	<classpathentry kind="lib" path="lib/commons-validator-1.10.0.jar"/>
	<classpathentry kind="lib" path="lib/flatlaf-3.6.jar"/>
	<classpathentry kind="lib" path="lib/jbcrypt-0.4.jar"/>
	<classpathentry kind="lib" path="lib/slf4j-api-2.0.18.jar"/>
	<classpathentry kind="lib" path="lib/slf4j-simple-2.0.18.jar"/>
	<classpathentry kind="lib" path="lib/postgresql-42.7.11.jar"/>
	<classpathentry kind="lib" path="lib/jackson-annotations-2.9.9.jar"/>
	<classpathentry kind="lib" path="lib/jackson-core-2.9.0.jar"/>
	<classpathentry kind="lib" path="lib/jackson-databind-2.9.9.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
