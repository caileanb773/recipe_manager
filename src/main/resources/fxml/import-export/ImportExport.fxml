<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.ImportExportController">

    <top>
        <Label styleClass="header" text="Import / Export">
            <BorderPane.margin>
                <Insets left="15.0" top="15.0" />
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <TabPane styleClass="background-offset" tabClosingPolicy="UNAVAILABLE">

            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>

            <tabs>

                <Tab text="Import">
                    <content>
                        <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="import-tab">
                     <VBox fx:id="importDropzone" alignment="CENTER" onDragDropped="#onImportZoneDragDropped" onDragEntered="#onImportZoneDragEntered" onDragExited="#onImportZoneDragExited" onDragOver="#onImportZoneDragOver" spacing="20.0" styleClass="import-border">
                        <children>
                           <ImageView pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../../img/icon/original/other/import-scaled.png" />
                              </image>
                              <VBox.margin>
                                 <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                              </VBox.margin>
                           </ImageView>
      
                                  <Label styleClass="header-4" text="Drag and drop a JSON file here">
                              <VBox.margin>
                                 <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                              </VBox.margin>
                           </Label>
                        </children>
                        <VBox.margin>
                           <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                        </VBox.margin>
                     </VBox>

                             <Label styleClass="sub-header" text="Or import from file" />

                            <VBox alignment="CENTER" spacing="10.0">

                                <Button fx:id="importBtn" onAction="#onImportBtnClicked" styleClass="primary-button" text="Choose File" />

                            </VBox>

                            <VBox alignment="CENTER" styleClass="import-info-box">

                                <Label styleClass="import-tip" text="ⓘ  This will add the recipes from the selected file to your existing collection." wrapText="true">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding></Label>
                        <VBox.margin>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </VBox.margin>

                            </VBox>

                        </VBox>
                    </content>
                </Tab>

                <Tab text="Export">
                    <content>
                        <VBox alignment="CENTER" spacing="20.0" styleClass="export-tab">
                     <children>
                        <VBox VBox.vgrow="ALWAYS">
                           <children>
                              <Label styleClass="header-4" text="What to export" />
                              <RadioButton mnemonicParsing="false" text="All recipes" />
                              <Label styleClass="sub-header" text="Exports your entire recipe collection." />
                              <RadioButton mnemonicParsing="false" text="Selected recipes" />
                              <Label styleClass="sub-header" text="Only exports the recipes you have selected." />
                           </children>
                           <VBox.margin>
                              <Insets left="15.0" right="15.0" />
                           </VBox.margin>
                        </VBox>
                        <Button mnemonicParsing="false" styleClass="primary-button" text="Export Recipes">
                           <graphic>
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../img/icon/scaled/light/imp-exp-light-scaled.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Label styleClass="import-tip" text="ⓘ  This will download your recipes as a JSON file for backup or sharing." wrapText="true" VBox.vgrow="ALWAYS">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </Label>
                     </children>

                        </VBox>
                    </content>
                </Tab>

            </tabs>
         <stylesheets>
            <URL value="@../../css/theme.css" />
            <URL value="@../../css/application.css" />
            <URL value="@../../css/components/buttons.css" />
            <URL value="@../../css/components/typography.css" />
         </stylesheets>
        </TabPane>
    </center>

    <stylesheets>
        <URL value="@../../css/application.css" />
        <URL value="@../../css/theme.css" />
        <URL value="@../../css/components/typography.css" />
        <URL value="@../../css/components/buttons.css" />
        <URL value="@../../css/components/tabpane.css" />
      <URL value="@../../css/pages/importexport.css" />
      <URL value="@../../css/components/radio-button.css" />
    </stylesheets>

</BorderPane>
