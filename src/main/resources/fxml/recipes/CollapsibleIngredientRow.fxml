<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.CollapsibleIngredientRowController">
   <children>
      <HBox alignment="BASELINE_CENTER">
         <children>
            <Label fx:id="ingredientName" styleClass="simple-text" />
            <Label fx:id="ingredientAmtUnit" styleClass="sub-header">
               <HBox.margin>
                  <Insets left="15.0" right="15.0" />
               </HBox.margin></Label>
            <Label fx:id="ingredientNotes" styleClass="sub-header" />
            <Separator prefWidth="200.0" visible="false" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <stylesheets>
      <URL value="@../../css/theme.css" />
      <URL value="@../../css/application.css" />
      <URL value="@../../css/components/buttons.css" />
      <URL value="@../../css/components/typography.css" />
      <URL value="@../../css/pages/view-recipe.css" />
   </stylesheets>
</VBox>
