<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER_LEFT" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.CollapsibleIngredientRowController">
   <children>
      <HBox alignment="CENTER">
         <children>
            <Button fx:id="expandIngredientNotes" contentDisplay="GRAPHIC_ONLY" graphicTextGap="0.0" mnemonicParsing="false" onAction="#onExpandIngredientNotesClicked" styleClass="icon-only-button">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/dark/chevron-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Label fx:id="ingredientName" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="ingredientAmtUnit" />
         </children>
         <stylesheets>
            <URL value="@../../css/theme.css" />
            <URL value="@../../css/application.css" />
            <URL value="@../../css/components/buttons.css" />
            <URL value="@../../css/components/typography.css" />
         </stylesheets>
      </HBox>
      <Label fx:id="ingredientNotes" text="Label" visible="false" VBox.vgrow="NEVER" />
   </children>
</VBox>
