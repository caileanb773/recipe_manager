<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="card" maxWidth="350.0" prefHeight="250.0" prefWidth="350.0" styleClass="recipe-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.RecipeCardController">

    <VBox styleClass="recipe-card-content">

        <ImageView fx:id="recipeImage" fitHeight="180.0" fitWidth="350.0" />

        <VBox styleClass="recipe-info" VBox.vgrow="NEVER">

            <Label fx:id="recipeName" styleClass="recipe-name" />

            <HBox styleClass="recipe-meta" VBox.vgrow="NEVER">
   
               <FlowPane fx:id="tagsPane" prefWidth="350.0" styleClass="recipe-tags" />
            <Button fx:id="recipeOptionsButton" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#onRecipeOptionsButtonClicked" styleClass="icon-button" text="Button">
               <graphic>
                  <ImageView pickOnBounds="true">
                     <image>
                        <Image url="@../../img/icon/scaled/dark/options-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            </HBox>

        </VBox>

    </VBox>
   <stylesheets>
      <URL value="@../../css/application.css" />
      <URL value="@../../css/components/recipe-card.css" />
      <URL value="@../../css/components/buttons.css" />
   </stylesheets>

</StackPane>
