<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="400.0" minWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.RecipeListController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="100.0" prefWidth="451.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="TOP_RIGHT">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="SOMETIMES">
                           <children>
                              <Label text="Recipes" />
                              <Label text="123 recipes" />
                           </children>
                        </VBox>
                        <TextField promptText="Search recipes..." />
                        <Button mnemonicParsing="false" text="Filter" />
                        <Button mnemonicParsing="false" text="+ Add Recipe" textAlignment="CENTER" />
                     </children>
                  </HBox>
                  <HBox alignment="BOTTOM_CENTER" fillHeight="false" VBox.vgrow="SOMETIMES">
                     <children>
                        <HBox alignment="CENTER_LEFT" HBox.hgrow="SOMETIMES">
                           <children>
                              <Button fx:id="listViewBtn" mnemonicParsing="false" onAction="#onListViewBtnClicked" text="List" />
                              <Button fx:id="gridViewBtn" mnemonicParsing="false" onAction="#onGridViewBtnClicked" text="Grid" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="SOMETIMES">
                           <children>
                              <ComboBox prefWidth="150.0" promptText="Last Updated" />
                              <ComboBox prefWidth="150.0" promptText="Category" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fx:id="recipeScrollPane" fitToHeight="true" fitToWidth="true" prefViewportHeight="200.0" prefViewportWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
