<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.RecipeViewController">
   <center>
      <TabPane fx:id="tabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab fx:id="ingredientsTab" text="Untitled Tab 1" />
          <Tab fx:id="directionsTab" text="Untitled Tab 2" />
        </tabs>
      </TabPane>
   </center>
   <stylesheets>
      <URL value="@../../css/application.css" />
      <URL value="@../../css/theme.css" />
      <URL value="@../../css/components/typography.css" />
      <URL value="@../../css/components/buttons.css" />
   </stylesheets>
   <top>
      <VBox fx:id="headerVBox" BorderPane.alignment="CENTER">
         <children>
            <HBox fx:id="navigationHeader" alignment="CENTER_LEFT">
               <children>
                  <Button fx:id="navBackButton" contentDisplay="GRAPHIC_ONLY" graphicTextGap="0.0" mnemonicParsing="false" onAction="#onNavBackButtonClicked" styleClass="page-navigation-button">
                     <graphic>
                        <ImageView pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../img/icon/scaled/other/nav-back-gray-scaled.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Label alignment="TOP_LEFT" styleClass="sub-header" text="Back to Recipes">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets left="15.0" right="15.0" top="15.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="CENTER" fillHeight="false">
               <children>
                  <HBox fx:id="titleHeader" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="recipeTitleHeader" styleClass="header-2" HBox.hgrow="NEVER">
                           <HBox.margin>
                              <Insets left="15.0" />
                           </HBox.margin>
                        </Label>
                     </children>
                  </HBox>
                  <HBox fx:id="headerButtons">
                     <children>
                        <Button fx:id="editButton" mnemonicParsing="false" onAction="#onEditButtonClicked" styleClass="default-button" text="Edit" HBox.hgrow="NEVER">
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="removeButton" mnemonicParsing="false" onAction="#onRemoveRecipeButtonClicked" styleClass="primary-button" text="Remove Recipe" HBox.hgrow="NEVER">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <graphic>
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../img/icon/scaled/light/garbage-light-scaled.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                     <HBox.margin>
                        <Insets right="15.0" />
                     </HBox.margin>
                  </HBox>
               </children>
            </HBox>
            <HBox fx:id="tagsHBox" />
         </children>
      </VBox>
   </top>
</BorderPane>
