<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="sidebar" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.SidebarController">
   <bottom>
      <BorderPane prefHeight="58.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <bottom>
            <Label styleClass="profile-name" text="John D." textFill="WHITE">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/person-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
         </bottom>
         <left>
            <Label styleClass="online-status" text="Online" textFill="WHITE" BorderPane.alignment="CENTER">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/cloud-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
         </left>
      </BorderPane>
   </bottom>
   <center>
      <VBox fx:id="buttonVBox" prefHeight="200.0" prefWidth="165.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="recipesContextBtn" mnemonicParsing="false" onAction="#onRecipesContextBtnClick" styleClass="nav-button" stylesheets="@../../css/application.css" text="Recipes">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/open-book-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="prepListsContextBtn" layoutX="20.0" layoutY="176.0" mnemonicParsing="false" onAction="#onPrepListsContextBtnClick" styleClass="nav-button" text="Prep Lists">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/knife-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="costingContextBtn" mnemonicParsing="false" onAction="#onCostingContextBtnClick" styleClass="nav-button" text="Costing">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/dollar-currency-symbol-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="notificationsContextBtn1" mnemonicParsing="false" onAction="#onNotificationsContextBtnClick" styleClass="nav-button" text="Notifications">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/notification-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="settingsContextBtn" mnemonicParsing="false" onAction="#onSettingsContextBtnClick" styleClass="nav-button" text="Settings">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/setting-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <top>
      <Label alignment="CENTER" styleClass="sidebar-header" text="PrepLedger" textFill="WHITE">
         <graphic>
            <ImageView pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../img/icon/scaled/Logo-scaled.png" />
               </image>
            </ImageView>
         </graphic>
      </Label>
   </top>
   <stylesheets>
      <URL value="@../../css/application.css" />
      <URL value="@../../css/sidebar.css" />
   </stylesheets>
</BorderPane>
