<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="sidebar" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.prepledger.controller.SidebarController">
   <bottom>
      <BorderPane BorderPane.alignment="CENTER">
         <bottom>
            <Label alignment="TOP_LEFT" styleClass="profile-name" text="John D." textFill="WHITE" BorderPane.alignment="CENTER_LEFT">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/light/profile-light-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
         </bottom>
         <top>
            <Label alignment="TOP_LEFT" styleClass="online-status" text="Online" textFill="WHITE" BorderPane.alignment="CENTER_LEFT">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/light/cloud-light-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
         </top>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" />
         </BorderPane.margin>
      </BorderPane>
   </bottom>
   <center>
      <VBox fx:id="buttonVBox" prefHeight="200.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="recipesContextBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onRecipesContextBtnClick" styleClass="nav-button" stylesheets="@../../css/application.css" text="Recipes">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/light/book-light-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="prepListsContextBtn" layoutX="20.0" layoutY="176.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPrepListsContextBtnClick" styleClass="nav-button" text="Prep Lists">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/light/knife-light-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="costingContextBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCostingContextBtnClick" styleClass="nav-button" text="Costing">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/light/dollar-light-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="notificationsContextBtn1" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNotificationsContextBtnClick" styleClass="nav-button" text="Notifications">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/light/notification-light-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="settingsContextBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSettingsContextBtnClick" styleClass="nav-button" text="Settings">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/icon/scaled/light/settings-light-scaled.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <top>
      <Label alignment="CENTER" styleClass="sidebar-header" text="PrepLedger" textFill="WHITE">
         <graphic>
            <ImageView pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../img/icon/Logo-scaled.png" />
               </image>
            </ImageView>
         </graphic>
      </Label>
   </top>
   <stylesheets>
      <URL value="@../../css/application.css" />
      <URL value="@../../css/sidebar.css" />
   </stylesheets>
</BorderPane>
